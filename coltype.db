PRAGMA foreign_keys=OFF;
BEGIN TRANSACTION;
CREATE TABLE races(
  "Date" TEXT,
  "Track" TEXT,
  "Race" INTEGER,
  "Class" TEXT,
  "Distance" INTEGER,
  "Surface" TEXT,
  "Price" REAL,
  "Horse" TEXT,
  "Lifetime Starts" TEXT,
  "Wins" INTEGER,
  "Place" INTEGER,
  "Show" INTEGER,
  "Avg. B. Ranking" REAL,
  "Avg. B. Delta" REAL,
  "Last B. Ranking" REAL,
  "Last B. Delta" REAL,
  "Max B. Ranking" REAL,
  "Max B. Delta" REAL,
  "Jockey Ranking" REAL,
  "Jockey" REAL,
  "Early Ranking" REAL,
  "Early" REAL,
  "Trainer Ranking" REAL,
  "Trainer" REAL,
  "Work Ranking" REAL,
  "Works" REAL,
  "Year Earnings Rankings" REAL,
  "Year Earnings" REAL,
  "Form" TEXT,
  "Super Gain" TEXT,
  "Class Change" INTEGER,
  "Won Last" TEXT,
  "Last Finish" INTEGER,
  "Last Finish Distance" REAL,
  "Had Bullet" TEXT,
  "Fluke" TEXT,
  "Tom Dist" INTEGER,
  "Tom Turf" INTEGER,
  "Tom Mud" INTEGER,
  "Layoff" INTEGER
);
